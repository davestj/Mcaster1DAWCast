/* Mcaster1DAWCast — Dark Studio Theme
 * Professional dark theme matching the web interface color scheme.
 * Variables substituted by ThemeEngine from theme.yaml.
 */

/* ── Global ────────────────────────────────────────────────────────── */

* {
    color: ${text_primary};
    font-family: -apple-system, "Segoe UI", "Helvetica Neue", sans-serif;
    font-size: 13px;
    outline: none;
}

QMainWindow {
    background-color: ${primary};
}

QWidget {
    background-color: ${primary};
    color: ${text_primary};
}

QDockWidget {
    color: ${text_primary};
    titlebar-close-icon: url(:/icons/close.svg);
    titlebar-normal-icon: url(:/icons/undock.svg);
}

QDockWidget::title {
    background-color: ${secondary};
    padding: 8px 12px;
    border-bottom: 1px solid ${border};
    font-weight: 600;
}

/* ── Transport Bar ─────────────────────────────────────────────────── */

#TransportBar {
    background-color: ${transport_bg};
    border-top: 1px solid ${border};
    padding: 8px 12px;
}

#TransportBar QPushButton {
    min-width: 42px;
    min-height: 42px;
    border-radius: 21px;
    border: 1px solid ${button_border};
    background-color: ${button_bg};
    color: ${text_primary};
    font-size: 16px;
    font-weight: bold;
}

#TransportBar QPushButton:hover {
    border-color: ${highlight};
    background-color: #2d3348;
}

#TransportBar QPushButton:pressed {
    background-color: ${accent};
    border-color: ${highlight};
}

#TransportBar QPushButton#playButton:checked {
    background-color: ${onair_green};
    color: ${primary};
    border-color: ${onair_green};
}

#TransportBar QPushButton#stopButton {
    color: ${text_secondary};
}

#TransportBar QPushButton#recordButton {
    color: ${record_red};
    font-weight: bold;
}

#TransportBar QPushButton#recordButton:checked {
    background-color: ${record_red};
    color: white;
    border-color: ${record_red};
}

#TransportBar QLabel#timeDisplay {
    font-family: "JetBrains Mono", "SF Mono", "Courier New", "Menlo", monospace;
    font-size: 20px;
    font-weight: bold;
    color: ${highlight};
    background-color: ${primary};
    border: 1px solid ${border};
    border-radius: 6px;
    padding: 6px 14px;
    letter-spacing: 1px;
}

/* ── Timeline ──────────────────────────────────────────────────────── */

#TimelineWidget {
    background-color: ${timeline_bg};
    border: 1px solid ${border};
}

/* ── Track Headers ─────────────────────────────────────────────────── */

#TrackHeaderWidget {
    background-color: ${track_header_bg};
    border-right: 1px solid ${border};
    border-bottom: 1px solid ${border};
    padding: 6px 8px;
}

#TrackHeaderWidget QLabel {
    color: ${text_primary};
    font-weight: 600;
    font-size: 12px;
}

#TrackHeaderWidget QPushButton {
    min-width: 26px;
    min-height: 20px;
    border-radius: 4px;
    border: 1px solid ${button_border};
    background-color: ${button_bg};
    color: ${text_secondary};
    font-size: 10px;
    font-weight: bold;
    padding: 2px 4px;
}

#TrackHeaderWidget QPushButton:hover {
    border-color: ${highlight};
    background-color: #2d3348;
}

#TrackHeaderWidget QPushButton#muteButton:checked {
    background-color: ${mute_orange};
    color: white;
    border-color: ${mute_orange};
}

#TrackHeaderWidget QPushButton#soloButton:checked {
    background-color: ${solo_yellow};
    color: ${primary};
    border-color: ${solo_yellow};
}

#TrackHeaderWidget QPushButton#recordArmButton:checked {
    background-color: ${record_red};
    color: white;
    border-color: ${record_red};
}

/* ── Mixer ─────────────────────────────────────────────────────────── */

#MixerWidget {
    background-color: ${secondary};
    border-top: 1px solid ${border};
}

QSlider::groove:vertical {
    width: 4px;
    background-color: ${fader_groove};
    border-radius: 2px;
    border: 1px solid ${border};
}

QSlider::handle:vertical {
    height: 14px;
    width: 22px;
    background-color: ${fader_handle};
    border-radius: 7px;
    border: none;
    margin: 0 -9px;
}

QSlider::handle:vertical:hover {
    background-color: #5eebd4;
}

QSlider::groove:horizontal {
    height: 4px;
    background-color: ${fader_groove};
    border-radius: 2px;
}

QSlider::handle:horizontal {
    width: 14px;
    height: 14px;
    background-color: ${fader_handle};
    border-radius: 7px;
    border: none;
    margin: -5px 0;
}

QSlider::handle:horizontal:hover {
    background-color: #5eebd4;
}

/* ── Menus ─────────────────────────────────────────────────────────── */

QMenuBar {
    background-color: ${primary};
    color: ${text_primary};
    border-bottom: 1px solid ${border};
    padding: 2px 0;
}

QMenuBar::item {
    padding: 6px 12px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: ${accent};
    color: ${highlight};
}

QMenu {
    background-color: ${secondary};
    color: ${text_primary};
    border: 1px solid ${border};
    border-radius: 6px;
    padding: 6px;
}

QMenu::item {
    padding: 8px 28px 8px 12px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: ${accent};
    color: ${highlight};
}

QMenu::separator {
    height: 1px;
    background-color: ${border};
    margin: 6px 10px;
}

QMenu::indicator {
    width: 16px;
    height: 16px;
    margin-left: 6px;
}

/* ── Tabs ──────────────────────────────────────────────────────────── */

QTabWidget::pane {
    border: 1px solid ${border};
    background-color: ${primary};
    border-radius: 0 0 4px 4px;
}

QTabBar::tab {
    background-color: transparent;
    color: ${text_secondary};
    padding: 10px 18px;
    border: none;
    border-bottom: 2px solid transparent;
    margin-right: 2px;
    font-weight: 500;
}

QTabBar::tab:selected {
    color: ${highlight};
    border-bottom: 2px solid ${highlight};
}

QTabBar::tab:hover:!selected {
    color: ${text_primary};
    border-bottom: 2px solid ${accent};
}

/* ── Scrollbars ────────────────────────────────────────────────────── */

QScrollBar:vertical {
    width: 8px;
    background-color: transparent;
    border: none;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background-color: ${button_border};
    border-radius: 4px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background-color: ${text_secondary};
}

QScrollBar:horizontal {
    height: 8px;
    background-color: transparent;
    border: none;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background-color: ${button_border};
    border-radius: 4px;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background-color: ${text_secondary};
}

QScrollBar::add-line, QScrollBar::sub-line,
QScrollBar::add-page, QScrollBar::sub-page {
    width: 0;
    height: 0;
    background: transparent;
    border: none;
}

/* ── Input Fields ──────────────────────────────────────────────────── */

QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: ${primary};
    color: ${text_primary};
    border: 1px solid ${border};
    border-radius: 6px;
    padding: 6px 10px;
    selection-background-color: ${accent};
    selection-color: ${highlight};
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus,
QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: ${highlight};
}

QComboBox {
    padding-right: 24px;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
    border-left: 1px solid ${border};
}

QComboBox::down-arrow {
    image: none;
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid ${text_secondary};
    margin-right: 6px;
}

QComboBox QAbstractItemView {
    background-color: ${secondary};
    color: ${text_primary};
    border: 1px solid ${border};
    border-radius: 6px;
    selection-background-color: ${accent};
    selection-color: ${highlight};
    padding: 4px;
    outline: none;
}

/* ── Buttons ───────────────────────────────────────────────────────── */

QPushButton {
    background-color: ${button_bg};
    color: ${text_primary};
    border: 1px solid ${button_border};
    border-radius: 6px;
    padding: 7px 18px;
    font-weight: 500;
}

QPushButton:hover {
    border-color: ${highlight};
    background-color: #2d3348;
}

QPushButton:pressed {
    background-color: ${accent};
    border-color: ${highlight};
}

QPushButton:checked {
    background-color: ${accent};
    color: ${highlight};
    border-color: ${highlight};
}

QPushButton:disabled {
    color: #4a4f60;
    background-color: ${primary};
    border-color: ${border};
}

/* ── Tooltips ──────────────────────────────────────────────────────── */

QToolTip {
    background-color: ${secondary};
    color: ${text_primary};
    border: 1px solid ${highlight};
    padding: 6px 10px;
    border-radius: 6px;
    font-size: 12px;
}

/* ── Group Boxes ───────────────────────────────────────────────────── */

QGroupBox {
    border: 1px solid ${border};
    border-radius: 6px;
    margin-top: 12px;
    padding: 12px 8px 8px 8px;
    font-weight: 600;
}

QGroupBox::title {
    color: ${highlight};
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    font-size: 12px;
}

/* ── Progress Bars ─────────────────────────────────────────────────── */

QProgressBar {
    background-color: ${primary};
    border: 1px solid ${border};
    border-radius: 4px;
    text-align: center;
    color: ${text_primary};
    font-size: 11px;
    height: 8px;
}

QProgressBar::chunk {
    background-color: ${highlight};
    border-radius: 3px;
}

/* ── Splitters ─────────────────────────────────────────────────────── */

QSplitter::handle {
    background-color: ${border};
}

QSplitter::handle:horizontal {
    width: 1px;
}

QSplitter::handle:vertical {
    height: 1px;
}

QSplitter::handle:hover {
    background-color: ${highlight};
}

/* ── Status Bar ────────────────────────────────────────────────────── */

QStatusBar {
    background-color: ${transport_bg};
    color: ${text_secondary};
    border-top: 1px solid ${border};
    font-size: 12px;
    padding: 2px 8px;
}

QStatusBar::item {
    border: none;
}

/* ── Tree / List Views ─────────────────────────────────────────────── */

QTreeView, QListView, QTableView {
    background-color: ${primary};
    color: ${text_primary};
    border: 1px solid ${border};
    border-radius: 6px;
    alternate-background-color: ${secondary};
    selection-background-color: ${accent};
    selection-color: ${highlight};
    outline: none;
}

QTreeView::item, QListView::item, QTableView::item {
    padding: 4px 8px;
    border-radius: 3px;
}

QTreeView::item:hover, QListView::item:hover, QTableView::item:hover {
    background-color: ${accent};
}

QTreeView::item:selected, QListView::item:selected, QTableView::item:selected {
    background-color: ${accent};
    color: ${highlight};
}

QHeaderView::section {
    background-color: ${secondary};
    color: ${text_secondary};
    border: none;
    border-bottom: 1px solid ${border};
    border-right: 1px solid ${border};
    padding: 6px 10px;
    font-weight: 600;
    font-size: 11px;
}

/* ── Dialogs ───────────────────────────────────────────────────────── */

QDialog {
    background-color: ${primary};
    border: 1px solid ${border};
}

QDialogButtonBox QPushButton {
    min-width: 80px;
}

/* ── Check / Radio Boxes ───────────────────────────────────────────── */

QCheckBox, QRadioButton {
    color: ${text_primary};
    spacing: 8px;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid ${button_border};
    background-color: ${primary};
}

QCheckBox::indicator {
    border-radius: 4px;
}

QRadioButton::indicator {
    border-radius: 8px;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: ${highlight};
    border-color: ${highlight};
}

QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: ${highlight};
}

/* ── Toolbar ───────────────────────────────────────────────────────── */

QToolBar {
    background-color: ${secondary};
    border: none;
    border-bottom: 1px solid ${border};
    padding: 2px 4px;
    spacing: 4px;
}

QToolBar::separator {
    width: 1px;
    background-color: ${border};
    margin: 4px 6px;
}

QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 4px 8px;
    color: ${text_primary};
}

QToolButton:hover {
    background-color: ${accent};
    border-color: ${button_border};
}

QToolButton:pressed {
    background-color: ${button_bg};
    border-color: ${highlight};
}

QToolButton:checked {
    background-color: ${accent};
    border-color: ${highlight};
    color: ${highlight};
}

/* ── Spin Box Buttons ──────────────────────────────────────────────── */

QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    background-color: ${button_bg};
    border: none;
    border-left: 1px solid ${border};
    width: 20px;
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: ${accent};
}
