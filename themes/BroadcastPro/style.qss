/* Mcaster1DAWCast — Broadcast Pro Theme
 * High-contrast for on-air environments with minimal distractions.
 * Variables substituted by ThemeEngine from theme.yaml.
 */

* {
    color: ${text_primary};
    font-family: -apple-system, "Segoe UI", "Helvetica Neue", sans-serif;
    font-size: 14px;
}

QMainWindow {
    background-color: ${primary};
}

QWidget {
    background-color: ${primary};
    color: ${text_primary};
}

QDockWidget::title {
    background-color: ${secondary};
    padding: 6px;
    border-bottom: 2px solid ${accent};
    font-weight: bold;
    text-transform: uppercase;
}

/* ── Transport ─────────────────────────────────────────────────────── */

#TransportBar {
    background-color: ${transport_bg};
    border-top: 2px solid ${highlight};
    padding: 8px;
}

#TransportBar QPushButton {
    min-width: 44px;
    min-height: 44px;
    border-radius: 6px;
    border: 2px solid ${border};
    background-color: ${secondary};
    color: ${text_primary};
    font-size: 18px;
    font-weight: bold;
}

#TransportBar QPushButton:hover {
    border-color: ${waveform_color};
}

#TransportBar QPushButton#playButton:checked {
    background-color: ${onair_green};
    color: black;
    border-color: ${onair_green};
}

#TransportBar QPushButton#recordButton:checked {
    background-color: ${record_red};
    color: white;
    border-color: ${record_red};
}

#TransportBar QLabel#timeDisplay {
    font-family: "Courier New", "Menlo", monospace;
    font-size: 22px;
    font-weight: bold;
    color: ${waveform_color};
    background-color: black;
    border: 2px solid ${accent};
    border-radius: 4px;
    padding: 6px 12px;
}

/* ── Timeline ──────────────────────────────────────────────────────── */

#TimelineWidget {
    background-color: ${timeline_bg};
    border: 2px solid ${border};
}

#TrackHeaderWidget {
    background-color: ${track_header_bg};
    border-right: 2px solid ${border};
    border-bottom: 1px solid ${border};
}

/* ── Mixer ─────────────────────────────────────────────────────────── */

#MixerWidget {
    background-color: ${secondary};
    border-top: 2px solid ${accent};
}

QSlider::groove:vertical {
    width: 8px;
    background-color: ${fader_groove};
    border: 1px solid ${border};
    border-radius: 4px;
}

QSlider::handle:vertical {
    height: 20px;
    width: 28px;
    background-color: ${fader_handle};
    border: 2px solid ${accent};
    border-radius: 4px;
    margin: 0 -10px;
}

/* ── Menus ─────────────────────────────────────────────────────────── */

QMenuBar {
    background-color: ${primary};
    color: ${text_primary};
    border-bottom: 2px solid ${accent};
    font-weight: bold;
}

QMenuBar::item:selected {
    background-color: ${accent};
}

QMenu {
    background-color: ${secondary};
    color: ${text_primary};
    border: 2px solid ${border};
}

QMenu::item:selected {
    background-color: ${accent};
}

/* ── Inputs ────────────────────────────────────────────────────────── */

QLineEdit, QTextEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: black;
    color: ${text_primary};
    border: 2px solid ${border};
    border-radius: 4px;
    padding: 4px 8px;
}

QLineEdit:focus, QTextEdit:focus {
    border-color: ${waveform_color};
}

/* ── Buttons ───────────────────────────────────────────────────────── */

QPushButton {
    background-color: ${secondary};
    color: ${text_primary};
    border: 2px solid ${border};
    border-radius: 4px;
    padding: 8px 20px;
    font-weight: bold;
}

QPushButton:hover {
    border-color: ${waveform_color};
}

QPushButton:pressed {
    background-color: ${accent};
}

/* ── Tabs ──────────────────────────────────────────────────────────── */

QTabBar::tab {
    background-color: ${secondary};
    color: ${text_secondary};
    padding: 8px 16px;
    border: 2px solid ${border};
    border-bottom: none;
    font-weight: bold;
}

QTabBar::tab:selected {
    background-color: ${primary};
    color: ${waveform_color};
    border-bottom: 3px solid ${waveform_color};
}

/* ── Scrollbars ────────────────────────────────────────────────────── */

QScrollBar:vertical {
    width: 12px;
    background-color: ${primary};
}

QScrollBar::handle:vertical {
    background-color: ${border};
    border-radius: 5px;
    min-height: 24px;
}

QScrollBar:horizontal {
    height: 12px;
    background-color: ${primary};
}

QScrollBar::handle:horizontal {
    background-color: ${border};
    border-radius: 5px;
    min-width: 24px;
}

QScrollBar::add-line, QScrollBar::sub-line {
    width: 0;
    height: 0;
}

/* ── Tooltips ──────────────────────────────────────────────────────── */

QToolTip {
    background-color: ${accent};
    color: ${text_primary};
    border: 2px solid ${waveform_color};
    padding: 4px 8px;
    font-weight: bold;
}

/* ── Status Bar ────────────────────────────────────────────────────── */

QStatusBar {
    background-color: ${transport_bg};
    color: ${text_secondary};
    border-top: 2px solid ${accent};
    font-weight: bold;
}
